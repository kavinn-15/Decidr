# Database
DATABASE_URL=sqlite:///./decidr.db

# LLM Configuration
LLM_PROVIDER=gemini
LLM_MODE=cache
LLM_MODEL=gemini-1.5-pro
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Issue Tracker (mock | github)
TRACKER=mock
GITHUB_TOKEN=
GITHUB_REPO=

# SMTP Settings
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=decidr@example.com

# Demo & Operations
DEMO_MODE=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
