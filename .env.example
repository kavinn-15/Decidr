# ==============================================================================
# Decidr Root Environment Configuration Template
# ==============================================================================

# Application Environment (development | production | test)
ENVIRONMENT=development

# Database
# Development: sqlite:///./decidr.db
# Production: postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=sqlite:///./decidr.db

# Authentication Security (min 32 chars in production)
JWT_SECRET_KEY=change-me-to-a-very-secure-random-secret-key-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH_ENFORCED=true
DEMO_MODE=true

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://decidr.vercel.app

# Frontend Next.js Public URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# LLM Configuration (gemini | anthropic | fake)
LLM_PROVIDER=gemini
LLM_MODE=cache
LLM_MODEL=gemini-1.5-pro
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Issue Tracker (mock | github)
TRACKER=mock
GITHUB_TOKEN=
GITHUB_REPO=

# SMTP & Email Settings
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=decidr@example.com
RESEND_API_KEY=

# Slack & Timezone
SLACK_WEBHOOK_URL=
TIMEZONE=UTC

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase Storage
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=decidr-transcripts
